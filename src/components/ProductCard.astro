---
import { isSales } from '../lib/site.js';
const { p } = Astro.props;
const d = p.data;
---
<a class="card" data-type={d.type} href={`/${d.category}/${p.id}/`}>
  <div class="card-media">
    {d.images[0] ? <img src={d.images[0]} alt={d.title} loading="lazy" /> : <span>תמונה</span>}
    {d.on_sale && <span class="badge">מבצע</span>}
  </div>
  <div class="card-body">
    <h3>{d.title}</h3>
    {d.summary && <p>{d.summary}</p>}
    {isSales && d.price && <p class="price"><strong>{d.price}</strong></p>}
  </div>
</a>
