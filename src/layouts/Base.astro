---
import { company, divisions } from '../data/site.js';
import '../styles/global.css';

const { title, description = 'MTI, יצרנית ישראלית של אמבטיות, מקלחונים, ספא ובריכות נגד זרם מאז 1994.', whatsapp = company.whatsapp.bath } = Astro.props;
const fullTitle = title ? `${title} | MTI` : 'MTI | אמבטיה, מקלחת, ספא ובריכות';
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-row">
        <a class="logo" href="/">MTI<span>מאז {company.founded}</span></a>
        <nav class="main-nav" aria-label="ניווט ראשי">
          {divisions.map((d) => (
            <a href={`/${d.slug}/`} aria-current={path.startsWith(`/${d.slug}`) ? 'page' : undefined}>{d.title}</a>
          ))}
          <a href="/about/" aria-current={path.startsWith('/about') ? 'page' : undefined}>אודות</a>
          <a href="/contact/" aria-current={path.startsWith('/contact') ? 'page' : undefined}>צור קשר</a>
        </nav>
        <a class="btn btn-small" href={company.phoneHref}>{company.phone}</a>
      </div>
    </header>

    <main><slot /></main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <p class="logo">MTI</p>
          <p>יצרנית ישראלית של אמבטיות, מקלחונים, ספא ובריכות נגד זרם.</p>
        </div>
        {divisions.map((d) => (
          <div>
            <p class="footer-title">{d.title}</p>
            <ul>{d.categories.map((c) => <li><a href={`/${d.slug}/${c.slug}/`}>{c.title}</a></li>)}</ul>
          </div>
        ))}
        <div>
          <p class="footer-title">אולם התצוגה</p>
          <p>{company.address}</p>
          {company.hours.map(([d, h]) => <p>{d}: {h}</p>)}
          <p><a href={company.phoneHref}>{company.phone}</a></p>
        </div>
      </div>
      <p class="container copyright">© {new Date().getFullYear()} {company.legalName}</p>
    </footer>

    <a class="wa-float" href={`https://wa.me/${whatsapp}`} target="_blank" rel="noopener" aria-label="שליחת הודעת ווטסאפ">
      <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg>
    </a>
  </body>
</html>
