---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import { settings } from '../lib/site.js';
---
<Base title="אודות">
  <section class="hero small">
    <div class="container"><h1>אודות</h1><p class="lead">{settings.tagline}</p></div>
  </section>
  <section class="section">
    <div class="container two-col">
      <div><p class="lead" style="color:inherit">{settings.about}</p></div>
      <div class="promises">{settings.promises.map((x) => <div class="promise"><strong>{x.title}</strong><span>{x.text}</span></div>)}</div>
    </div>
  </section>
  <CtaBand />
</Base>
