---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import { divisions } from '../../data/site.js';

export function getStaticPaths() {
  return divisions.map((d) => ({ params: { division: d.slug }, props: { d } }));
}
const { d } = Astro.props;
---
<Base title={d.title} description={d.tagline} whatsapp={d.whatsapp}>
  <section class={`hero ${d.slug}`}>
    <div class="container">
      <p class="breadcrumbs"><a href="/">דף הבית</a> / {d.title}</p>
      <h1>{d.title}</h1>
      <p class="lead">{d.tagline}</p>
    </div>
  </section>
  <section class="section">
    <div class="container grid">
      {d.categories.map((c) => (
        <a class="card" href={`/${d.slug}/${c.slug}/`}>
          <div class={`card-media ${d.slug}`}>תמונה</div>
          <div class="card-body">
            <h3>{c.title}</h3>
            <p>{c.summary}</p>
            <ul class="chips">{c.items.map((i) => <li>{i}</li>)}</ul>
          </div>
        </a>
      ))}
    </div>
  </section>
  <CtaBand whatsapp={d.whatsapp} />
</Base>
