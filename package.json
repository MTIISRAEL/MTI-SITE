{
  "name": "mti-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:spa": "SITE=spa astro dev",
    "dev:bath": "SITE=bath astro dev",
    "dev:hub": "SITE=hub astro dev",
    "build": "npm run build:all",
    "build:spa": "SITE=spa astro build",
    "build:bath": "SITE=bath astro build",
    "build:hub": "SITE=hub astro build",
    "build:all": "npm run build:spa && npm run build:bath && npm run build:hub",
    "deploy": "wrangler deploy && wrangler deploy -c wrangler.bath.jsonc && wrangler deploy -c wrangler.hub.jsonc"
  },
  "dependencies": {
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "wrangler": "^4.143.0"
  }
}
